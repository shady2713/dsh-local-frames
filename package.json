{
  "name": "dsh-local-frames",
  "version": "0.1.0",
  "description": "DSH plugin: extract frames from local videos, deduplicate them, label objects with a vision model, and export images with CSV metadata.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
